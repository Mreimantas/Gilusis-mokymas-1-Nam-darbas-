@startuml
title SteamSense - panaudojimo atvejai
left to right direction
actor "Vartotojas\n(žaidėjas / analitikas)" as U
actor "Steam Web API" as S <<sistema>>
actor "Gemini API" as G <<sistema>>
rectangle "SteamSense" {
  usecase "Įvesti Steam app_id" as UC1
  usecase "Gauti žaidimo apžvalgas" as UC2
  usecase "Klasifikuoti nuotaiką\nir aspektus" as UC3
  usecase "Sugeneruoti ataskaitą\n„žaidimas žaidėjų akimis“" as UC4
  usecase "Palyginti su kūrėjų aprašymu" as UC5
  usecase "Vizualizuoti rezultatus" as UC6
}
U --> UC1
U --> UC4
U --> UC6
UC1 ..> UC2 : <<include>>
UC4 ..> UC3 : <<include>>
UC5 ..> UC4 : <<extend>>
UC2 --> S
UC3 --> G
UC4 --> G
@enduml
